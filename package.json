{
  "name": "dsh-plugin-vajraclaw",
  "version": "1.1.9",
  "description": "Deterministic Runtime Execution Governance & Security Circuit-Breaker for DSH Agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "awesome-dsh-plugin",
    "awesome-dsh-plugins",
    "security",
    "governance",
    "agent-security",
    "runtime-security",
    "zero-trust",
    "vajraclaw",
    "dros",
    "deepseek-harness",
    "agent-governance",
    "guardrail",
    "circuit-breaker",
    "w3c-did",
    "rfc-010"
  ],
  "author": "Top-Celestial Company Ltd. / Jimmy Chen <service@dr-os.io>",
  "license": "SEE LICENSE IN https://dr-os.io",
  "homepage": "https://dr-os.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Top-Celestial-Company-Ltd/dsh-dros-vajraclaw.git"
  },
  "dsh": {
    "displayName": "DROS™ VajraClaw - Agent Governance",
    "id": "celestial.dros.vajraclaw",
    "version": "1.0.0",
    "bundle": "dist/index.js",
    "category": "security",
    "icon": "shield-check",
    "description": "Microsecond O(1) Tool-Call Enforcement & Prompt Injection Interception Gateway for DSH",
    "profiles": [
      "web",
      "tui",
      "eval"
    ],
    "settings": {
      "gatewayUrl": {
        "type": "string",
        "title": "DROS Gateway Endpoint",
        "default": "http://localhost:8080",
        "description": "The URL of the local or remote DROS Gateway Docker Container."
      },
      "licenseKey": {
        "type": "string",
        "title": "Gumroad License Key",
        "default": "",
        "description": "Enter your Hacker / Startup / Enterprise License Key to unlock higher concurrency."
      },
      "strictFailClosed": {
        "type": "boolean",
        "title": "Strict Fail-Closed Mode",
        "default": true,
        "description": "Block tool execution if DROS Gateway is unreachable."
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README_zh.md",
    "docs"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc --declaration --outDir dist src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "echo \"Running plugin tests...\" && exit 0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
